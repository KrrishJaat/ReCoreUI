# Adds "top_level_unica" to the list of top-level search keys collected by
# SecSettingsIntelligence, so the ReCoreUI Settings entry is categorized
# correctly by Settings search.
# Ported from UN1CA's customize.sh (was applied via SMALI_PATCH ... "replace",
# both scoped to the constructor).
#
# <init>(Landroid/content/Context;)V is a constructor, which smali always
# declares as `.method public constructor <init>(...)V` - unlike arbitrary
# Samsung method names/modifiers elsewhere in this port, this declaration
# format is a fixed smali convention, so it should be reliable across
# baselines.

FILE smali_classes2/com/samsung/android/settings/intelligence/search/categorizing/TopLevelKeysCollector.smali
PATCH .method public constructor <init>(Landroid/content/Context;)V
    .locals 36
- .locals 36
+ .locals 37

PATCH .method public constructor <init>(Landroid/content/Context;)V
    filled-new-array/range {v1 .. v35}, [Ljava/lang/String;
- filled-new-array/range {v1 .. v35}, [Ljava/lang/String;
+ const-string v36, "top_level_unica"
+
+ filled-new-array/range {v1 .. v36}, [Ljava/lang/String;
END

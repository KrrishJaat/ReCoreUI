# Registers ReCoreUI Settings screens with SecSettings' search feature, so
# their preferences show up when searching in Settings.
# Ported from UN1CA's customize.sh (was applied via SMALI_PATCH ... "replaceall"
# and "replace").
#
# Both replacements below are whole-class-unique fully-qualified smali
# instructions, so plain FIND_REPLACE (no method scoping needed) is safe here.

FILE smali/com/android/settingslib/search/SearchIndexableResourcesMobile.smali
FIND_REPLACE ".class public final Lcom/android/settingslib/search/SearchIndexableResourcesMobile;" ".class public Lcom/android/settingslib/search/SearchIndexableResourcesMobile;"
END

FILE smali/com/android/settings/search/SearchFeatureProviderImpl$$ExternalSyntheticLambda0.smali
FIND_REPLACE "new-instance p0, Lcom/android/settingslib/search/SearchIndexableResourcesMobile;" "new-instance p0, Lio/mesalabs/unica/search/UnicaSearchIndexableResources;"
FIND_REPLACE "invoke-direct {p0}, Lcom/android/settingslib/search/SearchIndexableResourcesBase;-><init>()V" "invoke-direct {p0}, Lio/mesalabs/unica/search/UnicaSearchIndexableResources;-><init>()V"
END
